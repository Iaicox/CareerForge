# ---------------------------------------------------------------------------
# CareerForge keeps a hard line between the framework (committed) and your
# data (never committed). Everything below is yours and stays on your machine.
# ---------------------------------------------------------------------------

# Your profile: CV master, candidate data, STAR stories, search queries.
# Generated by /setup from profile.example/.
/profile/*
!/profile/.gitkeep

# Your configuration: locale, statuses, page limits, Notion database ids.
/config/config.toml
/config/notion.json

# The application tracker database.
/tracker/*
!/tracker/.gitkeep

# Per-application documents and job snapshots.
# Folders move between these three as an application progresses.
/applications/*
!/applications/.gitkeep
/processing/*
!/processing/.gitkeep
/rejected/*
!/rejected/.gitkeep

# Career materials you drop in for /setup and /expand to read:
# CVs, certificates, reference letters, portfolio exports.
/documents/*
!/documents/.gitkeep
!/documents/README.md

# Job scraper state: seen postings and per-run shortlists.
/job_scraper/*
!/job_scraper/.gitkeep

# Secrets
.notion_token
.mail_password
.env

# Salary benchmark data (you supply your own dataset)
/salary_data.json

# Claude Code per-machine state
/.claude/settings.local.json
/.claude/projects/
/.claude/scheduled_tasks.lock
skills-lock.json

# ---------------------------------------------------------------------------
# Build output and tooling
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/

# Generated documents (sources are .md, these are rebuilt by tools/build.*)
*.pdf
*.docx
!/templates/*.docx

# LaTeX leftovers
*.aux
*.synctex.gz
*.fls
*.fdb_latexmk

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
