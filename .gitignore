# ---------------------------------------------------------------------------
# CareerForge keeps a hard line between the framework (committed) and your
# data (never committed). Everything below is yours and stays on your machine.
# ---------------------------------------------------------------------------

# Everything about you lives under data/ -- profile, configuration, the
# pipeline folders, the tracker state. data/.gitignore draws the line there:
# only the skeleton and the framework's templates are committed.

# Secrets
.notion_token
.mail_password
.env

# Claude Code per-machine state
/.claude/settings.local.json
/.claude/projects/
/.claude/scheduled_tasks.lock
skills-lock.json

# ---------------------------------------------------------------------------
# Build output and tooling
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/

# Generated documents (sources are .md, these are rebuilt by tools/build.*)
*.pdf
*.docx
!/templates/*.docx

# The published manual, built from docs/manual.md by tools/publish_manual.py
/docs/manual-artifact.html

# LaTeX leftovers
*.aux
*.synctex.gz
*.fls
*.fdb_latexmk

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
