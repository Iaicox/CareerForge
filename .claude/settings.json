{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Skill(job-application-assistant)",
      "Skill(job-scraper)",
      "Skill(application-tracker)",
      "WebSearch",
      "Bash(python tools/tracker.py:*)",
      "Bash(python tools/doctor.py:*)",
      "Bash(python tools/config_get.py:*)",
      "Bash(python tools/pagecount.py:*)",
      "Bash(python tools/board.py:*)",
      "Bash(python salary_lookup.py:*)",
      "Bash(tools/build.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File tools\\build.ps1 *)",
      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File tools\\make_reference.ps1 *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/first_run.py"
          }
        ]
      }
    ]
  }
}
